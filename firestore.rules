rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and strict per-user ownership
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and all personal nested data (bookmarks, drafts, activity, private notes)
    // Strict isolation: each user can ONLY read and write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Discussions authored by the user:
    // Only the author can create, read, update, and delete their own discussion documents
    match /discussions/{discussionId} {
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Replies / comments inside discussions:
      // Only the author can create, read, update, and delete their own replies
      match /replies/{replyId} {
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow read, update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Direct per-user collections fallback (e.g., user_data/{userId}/...)
    match /user_data/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Course Rooms (Ruang Kelas Google Classroom & Hybrid Scenarios)
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /{subcollection=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
